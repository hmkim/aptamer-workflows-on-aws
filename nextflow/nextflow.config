/* One workflow, four execution profiles. Runtime-specific values come from parameters or environment variables. */

def env = System.getenv()

manifest {
    name            = 'aptamer-workflow'
    description     = 'Aptamer sequencing quality control, trimming, counting, enrichment, and folding'
    mainScript      = 'main.nf'
    version         = '1.0.0'
    nextflowVersion = '>=24.10, <26'
}

params {
    help                   = false
    reads                  = null
    samplesheet            = 'samplesheet.tsv'
    input_dir              = env.INPUT_URI ?: null
    input_mode             = 'stage'
    outdir                 = env.OUTPUT_URI ?: 'results'
    publish_mode           = 'copy'
    report_dir             = env.REPORT_DIR ?: 'pipeline_info'

    front_primer           = env.FRONT_PRIMER ?: null
    back_primer            = env.BACK_PRIMER ?: null
    cutadapt_error_rate    = 0.12
    cutadapt_overlap       = 15
    min_length             = 10
    max_length             = 80
    top_n                  = 100
    pseudocount_rpm        = 0.01

    local_container        = env.LOCAL_CONTAINER ?: 'aptamer-workflow:latest'
    container              = env.PIPELINE_IMAGE ?: null
    tool_path              = '/opt/conda/bin:/opt/aptamer/bin'

    aws_region             = env.AWS_REGION ?: env.AWS_DEFAULT_REGION ?: null
    batch_queue            = env.BATCH_QUEUE ?: null
    batch_job_role         = env.BATCH_JOB_ROLE_ARN ?: null
    work_uri               = env.NXF_WORK ?: null
    mount_path             = env.MOUNT_PATH ?: '/mnt/s3-input'
}

process {
    container     = params.container ?: params.local_container
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    stageInMode   = 'symlink'
    stageOutMode  = 'copy'

    withLabel: small {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }
    withLabel: medium {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/trace.tsv"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/dag.mmd"
}

profiles {
    local {
        process.executor  = 'local'
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        workDir           = params.work_uri ?: 'work'
    }

    batch {
        params.input_mode = 'stage'
        process.executor  = 'awsbatch'
        process.queue     = params.batch_queue
        aws.region        = params.aws_region
        aws.batch.jobRole = params.batch_job_role
        aws.batch.maxParallelTransfers = 8
        aws.batch.maxTransferAttempts  = 3
        aws.batch.delayBetweenAttempts = '10 sec'
        aws.client.maxConnections      = 20
        workDir           = params.work_uri ?: 'work'
    }

    batch_mountpoint {
        params.input_mode = 'mount'
        process.executor  = 'awsbatch'
        process.queue     = params.batch_queue
        aws.region        = params.aws_region
        aws.batch.jobRole = params.batch_job_role
        aws.batch.maxParallelTransfers = 8
        aws.batch.maxTransferAttempts  = 3
        aws.batch.delayBetweenAttempts = '10 sec'
        aws.client.maxConnections      = 20
        aws.batch.volumes              = [ "${params.mount_path}:${params.mount_path}:ro" ]
        workDir                        = params.work_uri ?: 'work'
    }

    healthomics {
        params.input_mode = 'stage'
        params.outdir     = '/mnt/workflow/pubdir'
        process.container = params.container
        process.scratch   = true
        trace.enabled     = false
        report.enabled    = false
        timeline.enabled  = false
        dag.enabled       = false
    }
}
