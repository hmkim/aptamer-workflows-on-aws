+def _choice_probabilities(p):
+    """Normalize sampling weights for current NumPy's strict sum check."""
+    p = np.asarray(p, dtype=np.float64)
+    total = np.sum(p, dtype=np.float64)
+    if not np.isfinite(total) or total <= 0:
+        raise ValueError("profile HMM sampling weights must have a positive finite sum")
+    p = p / total
+    p[-1] = 1.0 - np.sum(p[:-1], dtype=np.float64)
+    return p
+
